# Copie para `.env` no diretório de deploy da VPS.
# O CI sobrescreve IMAGE_TAG a cada deploy (com a tag recém-criada).
IMAGE_TAG=latest

# Porta no host (só localhost) que o Nginx vai proxiar. 3003 está livre na VPS atual.
BACKEND_PORT=3003

# Origem do frontend permitida no CORS (HTTP + WebSocket). OBRIGATÓRIA em produção.
# Use o domínio público servido pelo Nginx/TLS. Várias origens: separe por vírgula.
FRONTEND_ORIGIN=https://SEU-DOMINIO-FRONTEND
