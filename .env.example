# Porta HTTP/WebSocket do backend.
PORT=3000

# Origem(ns) permitida(s) no CORS (HTTP + WebSocket).
# Uma URL, ou várias separadas por vírgula. Ex.: https://jogo.exemplo.com
# Em dev pode ficar vazio (libera qualquer origem). OBRIGATÓRIO em produção.
FRONTEND_ORIGIN=

# Conexão com o Redis.
# Local (fora do Docker): 127.0.0.1
# Dentro do docker-compose: usar o nome do serviço -> redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
